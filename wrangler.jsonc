{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Production: the "myday" Worker, deployed by Workers Builds when main changes.
  "name": "myday",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-12",

  // The built app (npm run build → dist/). Only /api/* runs Worker code; everything else
  // is served straight from assets, and unknown paths fall back to index.html.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "myday-production", "database_id": "f5c16272-c408-4f8b-8848-2ae190cd0663", "migrations_dir": "migrations" }
  ],

  // Previews: every non-production branch gets its own preview of this Worker
  // (Workers Builds runs `wrangler preview`), always on the separate preview database.
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "myday-preview", "database_id": "8d4209d4-0ca6-4e2c-bcb9-b408bbe8ab77", "migrations_dir": "migrations" }
    ]
  }
}
