{
  "$schema": "node_modules/wrangler/config-schema.json",

  // The "myday" Worker, deployed by Workers Builds whenever main changes.
  "name": "myday",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-12",

  // The built app (npm run build → dist/). Only /api/* runs Worker code; everything else
  // is served straight from assets, and unknown paths fall back to index.html.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "myday-production", "database_id": "f5c16272-c408-4f8b-8848-2ae190cd0663", "migrations_dir": "migrations" }
  ]
}
