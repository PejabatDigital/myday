{
  "name": "myday",
  "version": "0.4.0",
  "private": true,
  "description": "A no-frills daily planner: today's tasks and notes together. Offline-first. A Kasah Kod app.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:api": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote -c wrangler.preview-db.jsonc",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
